{
  "manifest_version": 3,
  "name": "弹幕桥·bilibili直播弹幕转接youtube",
  "version": "0.1.16",
  "description": "通过房间号、直播间链接或已打开的B站标签页，将直播弹幕转接到YouTube播放器。",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://live.bilibili.com/*",
    "https://www.youtube.com/*",
    "https://*.hdslb.com/*",
    "https://api.bilibili.com/*",
    "https://api.live.bilibili.com/*",
    "https://m.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://live.bilibili.com/*"
      ],
      "js": [
        "page-meta.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://live.bilibili.com/*"
      ],
      "js": [
        "lifecycle.js",
        "emoji.js",
        "source.js"
      ],
      "all_frames": true
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "youtube.js",
        "lifecycle.js",
        "emoji.js",
        "layout.js",
        "overlay.js"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "short_name": "弹幕桥",
  "minimum_chrome_version": "116"
}
